# Copy to .env and fill in to run the demo/examples against the real Verifik API.
# When VERIFIK_CLIENT_JWT is unset, quickstart / real_roundtrip use a local
# mock server (no credentials needed).

# Verifik client JWT (bearer). Get one from the dashboard at https://ai.verifik.co
# or the email-OTP API. See the README "Authentication (Verifik JWT)" section.
VERIFIK_CLIENT_JWT=

# Optional; defaults to https://api.verifik.co
HUMANAUTHN_BASE_URL=https://api.verifik.co

# Optional: path to a local face image for examples/real_roundtrip.py
# (never committed; fixtures/ and image files are git-ignored).
# HUMANAUTHN_FACE_IMAGE=./fixtures/me.jpg
